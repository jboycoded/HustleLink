rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                      'uid',
                      'fullName',
                      'email',
                      'roles',
                      'activeRole',
                      'location',
                      'skills',
                      'isVerified',
                      'profileCompleted',
                      'isAvailableForGigs',
                      'rating',
                      'completedGigs',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'fullName',
                      'email',
                      'roles',
                      'activeRole',
                      'location',
                      'skills',
                      'isVerified',
                      'profileCompleted',
                      'isAvailableForGigs',
                      'rating',
                      'completedGigs',
                      'createdAt'
                    ])
                    && request.resource.data.uid == userId
                    && request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.roles is list
                    && request.resource.data.activeRole in ['worker', 'poster']
                    && request.resource.data.location is string
                    && request.resource.data.skills is list
                    && request.resource.data.isVerified == false
                    && request.resource.data.profileCompleted is bool
                    && request.resource.data.isAvailableForGigs is bool
                    && request.resource.data.rating == 0
                    && request.resource.data.completedGigs == 0
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'fullName',
                         'location',
                         'skills',
                         'profileCompleted',
                         'activeRole',
                         'isAvailableForGigs',
                         'updatedAt'
                       ])
                    && request.resource.data.activeRole in ['worker', 'poster']
                    && request.resource.data.fullName is string
                    && request.resource.data.location is string
                    && request.resource.data.skills is list
                    && request.resource.data.profileCompleted is bool
                    && (
                      !('isAvailableForGigs' in request.resource.data)
                      || request.resource.data.isAvailableForGigs is bool
                    );

      allow delete: if false;
    }

    match /gigs/{gigId} {
      allow read: if request.auth != null
                  && (
                    resource.data.posterId == request.auth.uid
                    || resource.data.status == 'open'
                  );

      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                      'title',
                      'description',
                      'category',
                      'pay',
                      'posterId',
                      'posterName',
                      'location',
                      'when',
                      'status',
                      'proofVideoRequired',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'title',
                      'description',
                      'category',
                      'pay',
                      'posterId',
                      'posterName',
                      'location',
                      'when',
                      'status',
                      'proofVideoRequired',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.posterId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.description is string
                    && request.resource.data.category is string
                    && request.resource.data.pay is int
                    && request.resource.data.pay > 0
                    && request.resource.data.posterName is string
                    && request.resource.data.location is string
                    && request.resource.data.when is string
                    && request.resource.data.status == 'open'
                    && request.resource.data.proofVideoRequired is bool
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      allow update: if request.auth != null
                    && resource.data.posterId == request.auth.uid
                    && request.resource.data.posterId == resource.data.posterId
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'title',
                         'description',
                         'category',
                         'pay',
                         'location',
                         'when',
                         'status',
                         'proofVideoRequired',
                         'updatedAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.description is string
                    && request.resource.data.category is string
                    && request.resource.data.pay is int
                    && request.resource.data.pay > 0
                    && request.resource.data.location is string
                    && request.resource.data.when is string
                    && request.resource.data.status in ['open', 'closed']
                    && request.resource.data.proofVideoRequired is bool
                    && request.resource.data.updatedAt is timestamp;

      allow delete: if request.auth != null
                    && resource.data.posterId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null
                  && (
                    resource.data.workerId == request.auth.uid
                    || resource.data.posterId == request.auth.uid
                  );

      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                      'gigId',
                      'workerId',
                      'posterId',
                      'workerName',
                      'gigTitle',
                      'gigCategory',
                      'gigPay',
                      'gigLocation',
                      'status',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'gigId',
                      'workerId',
                      'posterId',
                      'workerName',
                      'gigTitle',
                      'gigCategory',
                      'gigPay',
                      'gigLocation',
                      'status',
                      'createdAt'
                    ])
                    && request.resource.data.workerId == request.auth.uid
                    && request.resource.data.posterId != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.workerName is string
                    && request.resource.data.gigTitle is string
                    && request.resource.data.gigCategory is string
                    && request.resource.data.gigPay is int
                    && request.resource.data.gigLocation is string
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/gigs/$(request.resource.data.gigId))
                    && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.status == 'open'
                    && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.posterId == request.resource.data.posterId;

      allow update: if request.auth != null
                    && resource.data.posterId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['accepted', 'rejected']
                    && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      allow read: if isParticipant();

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'applicationId',
          'gigId',
          'gigTitle',
          'workerId',
          'posterId',
          'workerName',
          'posterName',
          'participants',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'applicationId',
          'gigId',
          'gigTitle',
          'workerId',
          'posterId',
          'workerName',
          'posterName',
          'participants',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'createdAt'
        ])
        && request.auth.uid == request.resource.data.posterId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          request.resource.data.workerId,
          request.resource.data.posterId
        ])
        && getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.workerId == request.resource.data.workerId
        && getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.posterId == request.resource.data.posterId
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time;

      allow update: if isParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId'])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        function canAccessConversation() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants;
        }

        allow read: if canAccessConversation();

        allow create: if canAccessConversation()
          && request.resource.data.keys().hasAll([
            'senderId',
            'text',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
