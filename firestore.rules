rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                      'uid',
                      'fullName',
                      'email',
                      'roles',
                      'activeRole',
                      'location',
                      'skills',
                      'isVerified',
                      'profileCompleted',
                      'isAvailableForGigs',
                      'rating',
                      'completedGigs',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'fullName',
                      'email',
                      'roles',
                      'activeRole',
                      'location',
                      'skills',
                      'isVerified',
                      'profileCompleted',
                      'isAvailableForGigs',
                      'rating',
                      'completedGigs',
                      'createdAt'
                    ])
                    && request.resource.data.uid == userId
                    && request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.roles is list
                    && request.resource.data.activeRole in ['worker', 'poster']
                    && request.resource.data.location is string
                    && request.resource.data.skills is list
                    && request.resource.data.isVerified == false
                    && request.resource.data.profileCompleted is bool
                    && request.resource.data.isAvailableForGigs is bool
                    && request.resource.data.rating == 0
                    && request.resource.data.completedGigs == 0
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'fullName',
                         'location',
                         'skills',
                         'profileCompleted',
                         'activeRole',
                         'isAvailableForGigs',
                         'updatedAt'
                       ])
                    && request.resource.data.activeRole in ['worker', 'poster']
                    && request.resource.data.fullName is string
                    && request.resource.data.location is string
                    && request.resource.data.skills is list
                    && request.resource.data.profileCompleted is bool
                    && (
                      !('isAvailableForGigs' in request.resource.data)
                      || request.resource.data.isAvailableForGigs is bool
                    );

      allow delete: if false;
    }

    match /gigs/{gigId} {
      allow read: if request.auth != null
                  && (
                    resource.data.posterId == request.auth.uid
                    || resource.data.status == 'open'
                  );

      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll([
                      'title',
                      'description',
                      'category',
                      'pay',
                      'posterId',
                      'posterName',
                      'location',
                      'when',
                      'status',
                      'proofVideoRequired',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'title',
                      'description',
                      'category',
                      'pay',
                      'posterId',
                      'posterName',
                      'location',
                      'when',
                      'status',
                      'proofVideoRequired',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.posterId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.description is string
                    && request.resource.data.category is string
                    && request.resource.data.pay is int
                    && request.resource.data.pay > 0
                    && request.resource.data.posterName is string
                    && request.resource.data.location is string
                    && request.resource.data.when is string
                    && request.resource.data.status == 'open'
                    && request.resource.data.proofVideoRequired is bool
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      allow update: if request.auth != null
                    && resource.data.posterId == request.auth.uid
                    && request.resource.data.posterId == resource.data.posterId
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'title',
                         'description',
                         'category',
                         'pay',
                         'location',
                         'when',
                         'status',
                         'proofVideoRequired',
                         'updatedAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.description is string
                    && request.resource.data.category is string
                    && request.resource.data.pay is int
                    && request.resource.data.pay > 0
                    && request.resource.data.location is string
                    && request.resource.data.when is string
                    && request.resource.data.status in ['open', 'closed']
                    && request.resource.data.proofVideoRequired is bool
                    && request.resource.data.updatedAt is timestamp;

      allow delete: if request.auth != null
                    && resource.data.posterId == request.auth.uid;
    }
  }
}
