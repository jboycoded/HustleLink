rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                      'uid',
                      'fullName',
                      'email',
                      'roles',
                      'activeRole',
                      'location',
                      'skills',
                      'isVerified',
                      'profileCompleted',
                      'isAvailableForGigs',
                      'rating',
                      'completedGigs',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'fullName',
                      'email',
                      'roles',
                      'activeRole',
                      'location',
                      'skills',
                      'isVerified',
                      'profileCompleted',
                      'isAvailableForGigs',
                      'rating',
                      'completedGigs',
                      'createdAt',
                      'photoUrl'
                    ])
                    && request.resource.data.uid == userId
                    && request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.roles is list
                    && request.resource.data.roles.hasAll(['worker', 'poster'])
                    && request.resource.data.roles.hasOnly(['worker', 'poster'])
                    && request.resource.data.activeRole in request.resource.data.roles
                    && request.resource.data.location is string
                    && request.resource.data.skills is list
                    && request.resource.data.isVerified == false
                    && request.resource.data.profileCompleted is bool
                    && request.resource.data.isAvailableForGigs is bool
                    && request.resource.data.rating == 0
                    && request.resource.data.completedGigs == 0
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'fullName',
                         'location',
                         'skills',
                         'profileCompleted',
                         'activeRole',
                         'isAvailableForGigs',
                         'proofVideoUrl',
                         'photoUrl',
                         'updatedAt'
                       ])
                    && request.resource.data.activeRole in resource.data.roles
                    && request.resource.data.fullName is string
                    && request.resource.data.location is string
                    && request.resource.data.skills is list
                    && request.resource.data.profileCompleted is bool
                    && (
                      !('isAvailableForGigs' in request.resource.data)
                      || request.resource.data.isAvailableForGigs is bool
                    )
                    && (!('photoUrl' in request.resource.data)
                        || request.resource.data.photoUrl == null
                        || request.resource.data.photoUrl is string)
                    && (
                      !('proofVideoUrl' in request.resource.data)
                      || request.resource.data.proofVideoUrl == null
                      || request.resource.data.proofVideoUrl is string
                    );

      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'activeRole',
          'location',
          'skills',
          'isAvailableForGigs',
          'rating',
          'completedGigs',
          'proofVideoUrl',
          'photoUrl',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'activeRole',
          'location',
          'skills',
          'isAvailableForGigs',
          'rating',
          'completedGigs',
          'proofVideoUrl',
          'photoUrl',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.fullName is string
        && request.resource.data.activeRole in get(/databases/$(database)/documents/users/$(userId)).data.roles
        && request.resource.data.location is string
        && request.resource.data.skills is list
        && request.resource.data.isAvailableForGigs is bool
        && request.resource.data.rating == 0
        && request.resource.data.completedGigs == 0
        && get(/databases/$(database)/documents/users/$(userId)).data.rating == 0
        && get(/databases/$(database)/documents/users/$(userId)).data.completedGigs == 0
        && request.resource.data.fullName == get(/databases/$(database)/documents/users/$(userId)).data.fullName
        && request.resource.data.activeRole == get(/databases/$(database)/documents/users/$(userId)).data.activeRole
        && (
          !('proofVideoUrl' in request.resource.data)
          || request.resource.data.proofVideoUrl == null
          || request.resource.data.proofVideoUrl is string
        )
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'fullName',
            'activeRole',
            'location',
            'skills',
            'isAvailableForGigs',
            'proofVideoUrl',
            'photoUrl',
            'updatedAt'
          ])
        && request.resource.data.fullName is string
        && request.resource.data.activeRole == getAfter(/databases/$(database)/documents/users/$(userId)).data.activeRole
        && request.resource.data.location is string
        && request.resource.data.skills is list
        && request.resource.data.isAvailableForGigs is bool
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && (
          !('proofVideoUrl' in request.resource.data)
          || request.resource.data.proofVideoUrl == null
          || request.resource.data.proofVideoUrl is string
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /gigs/{gigId} {
      // Gig listings and their lifecycle status are public marketplace information.
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == 'poster'
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['poster'])
                    && request.resource.data.keys().hasAll([
                      'title',
                      'description',
                      'category',
                      'pay',
                      'posterId',
                      'posterName',
                      'location',
                      'when',
                      'status',
                      'proofVideoRequired',
                      'posterPhotoUrl',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'title',
                      'description',
                      'category',
                      'pay',
                      'posterId',
                      'posterName',
                      'location',
                      'when',
                      'status',
                      'proofVideoRequired',
                      'posterPhotoUrl',
                      'createdAt',
                      'updatedAt'
                    ])
                    && request.resource.data.posterId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.description is string
                    && request.resource.data.category is string
                    && request.resource.data.pay is int
                    && request.resource.data.pay > 0
                    && request.resource.data.posterName is string
        && (!('posterPhotoUrl' in request.resource.data) || request.resource.data.posterPhotoUrl == null || request.resource.data.posterPhotoUrl is string)
                    && request.resource.data.location is string
                    && request.resource.data.when is string
                    && request.resource.data.status == 'open'
                    && request.resource.data.proofVideoRequired is bool
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == 'poster'
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['poster'])
                    && resource.data.posterId == request.auth.uid
                    && request.resource.data.posterId == resource.data.posterId
                    && resource.data.get('status', 'open') == 'open'
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         'title',
                         'description',
                         'category',
                         'pay',
                         'location',
                         'when',
                         'status',
                         'proofVideoRequired',
                         'acceptedApplicationId',
                         'acceptedWorkerId',
                         'updatedAt'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.description is string
                    && request.resource.data.category is string
                    && request.resource.data.pay is int
                    && request.resource.data.pay > 0
                    && request.resource.data.location is string
                    && request.resource.data.when is string
                    && request.resource.data.status in ['open', 'closed', 'filled']
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
                      || (
                        resource.data.status == 'open'
                        && request.resource.data.status in ['closed', 'filled']
                      )
                    )
                    && (
                      request.resource.data.status != 'filled'
                      || (
                        request.resource.data.acceptedApplicationId is string
                        && request.resource.data.acceptedWorkerId is string
                        && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.acceptedApplicationId)).data.status == 'accepted'
                        && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.acceptedApplicationId)).data.gigId == gigId
                        && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.acceptedApplicationId)).data.workerId == request.resource.data.acceptedWorkerId
                      )
                    )
                    && (
                      (
                        !('proofVideoRequired' in resource.data)
                        && !('proofVideoRequired' in request.resource.data)
                      )
                      || request.resource.data.proofVideoRequired is bool
                    )
                    && request.resource.data.updatedAt is timestamp;


      allow update: if request.auth != null
        && (
          (
            request.auth.uid == resource.data.acceptedWorkerId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['workerCompletionConfirmed', 'status', 'completedAt', 'updatedAt'])
            && request.resource.data.workerCompletionConfirmed == true
            && request.resource.data.get('posterCompletionConfirmed', false) == resource.data.get('posterCompletionConfirmed', false)
          )
          ||
          (
            request.auth.uid == resource.data.posterId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['posterCompletionConfirmed', 'status', 'completedAt', 'updatedAt'])
            && request.resource.data.posterCompletionConfirmed == true
            && request.resource.data.get('workerCompletionConfirmed', false) == resource.data.get('workerCompletionConfirmed', false)
          )
        )
        && resource.data.status == 'filled'
        && request.resource.data.status in ['filled', 'completed']
        && (
          (request.resource.data.get('workerCompletionConfirmed', false) == true
            && request.resource.data.get('posterCompletionConfirmed', false) == true
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time)
          ||
          (request.resource.data.status == 'filled'
            && request.resource.data.get('completedAt', null) == resource.data.get('completedAt', null))
        )
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && resource.data.status == 'completed'
        && request.resource.data.status == 'completed'
        && (
          (
            request.auth.uid == resource.data.posterId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['posterPaymentConfirmed', 'paid', 'paidAt', 'updatedAt'])
            && request.resource.data.posterPaymentConfirmed == true
            && request.resource.data.get('workerPaymentConfirmed', false)
                == resource.data.get('workerPaymentConfirmed', false)
          )
          ||
          (
            request.auth.uid == resource.data.acceptedWorkerId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['workerPaymentConfirmed', 'paid', 'paidAt', 'updatedAt'])
            && request.resource.data.workerPaymentConfirmed == true
            && resource.data.get('posterPaymentConfirmed', false) == true
            && request.resource.data.get('posterPaymentConfirmed', false)
                == resource.data.get('posterPaymentConfirmed', false)
          )
        )
        && (
          (
            request.resource.data.get('posterPaymentConfirmed', false) == true
            && request.resource.data.get('workerPaymentConfirmed', false) == true
            && request.resource.data.paid == true
            && request.resource.data.paidAt == request.time
          )
          ||
          (
            !(
              request.resource.data.get('posterPaymentConfirmed', false) == true
              && request.resource.data.get('workerPaymentConfirmed', false) == true
            )
            && request.resource.data.get('paid', false) == resource.data.get('paid', false)
            && request.resource.data.get('paidAt', null) == resource.data.get('paidAt', null)
          )
        )
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['poster'])
                    && resource.data.posterId == request.auth.uid
                    && (
                      (
                        resource.data.status == 'closed'
                        && resource.data.get('acceptedWorkerId', '') == ''
                        && resource.data.get('acceptedApplicationId', '') == ''
                      )
                      ||
                      (
                        resource.data.status == 'completed'
                        && resource.data.get('acceptedWorkerId', '') is string
                        && resource.data.get('acceptedWorkerId', '') != ''
                        && resource.data.get('paid', false) == true
                        && resource.data.get('posterPaymentConfirmed', false) == true
                        && resource.data.get('workerPaymentConfirmed', false) == true
                      )
                    );
    }

    match /applications/{applicationId} {
      allow read: if request.auth != null
                  && (
                    resource.data.workerId == request.auth.uid
                    || resource.data.posterId == request.auth.uid
                  );

      allow create: if request.auth != null
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == 'worker'
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['worker'])
                    && request.resource.data.keys().hasAll([
                      'gigId',
                      'workerId',
                      'posterId',
                      'workerName',
                      'gigTitle',
                      'gigCategory',
                      'gigPay',
                      'gigLocation',
                      'workerPhotoUrl',
                      'status',
                      'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'gigId',
                      'workerId',
                      'posterId',
                      'workerName',
                      'gigTitle',
                      'gigCategory',
                      'gigPay',
                      'gigLocation',
                      'workerPhotoUrl',
                      'status',
                      'createdAt'
                    ])
                    && applicationId == request.resource.data.gigId + '_' + request.auth.uid
                    && request.resource.data.workerId == request.auth.uid
                    && request.resource.data.posterId != request.auth.uid
                    && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(request.resource.data.posterId))
                    && !exists(/databases/$(database)/documents/users/$(request.resource.data.posterId)/blockedUsers/$(request.auth.uid))
                    && request.resource.data.status == 'pending'
                    && request.resource.data.workerName is string
                    && request.resource.data.gigTitle is string
                    && request.resource.data.gigCategory is string
                    && request.resource.data.gigPay is int
                    && request.resource.data.gigLocation is string
                    && (!('workerPhotoUrl' in request.resource.data) || request.resource.data.workerPhotoUrl == null || request.resource.data.workerPhotoUrl is string)
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/gigs/$(request.resource.data.gigId))
                    && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.status == 'open'
                    && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.posterId == request.resource.data.posterId
                    && request.resource.data.gigTitle == get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.title
                    && request.resource.data.gigCategory == get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.category
                    && request.resource.data.gigPay == get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.pay
                    && request.resource.data.gigLocation == get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.location
                    && (
                      get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.proofVideoRequired == false
                      || (
                        exists(/databases/$(database)/documents/users/$(request.auth.uid))
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.proofVideoUrl is string
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.proofVideoUrl.size() > 0
                      )
                    );

      allow update: if request.auth != null
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeRole == 'poster'
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['poster'])
                    && resource.data.posterId == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(['status', 'updatedAt'])
                    && request.resource.data.status in ['accepted', 'rejected']
                    && (
                      request.resource.data.status != 'accepted'
                      || (
                        getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.status == 'filled'
                        && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.acceptedApplicationId == applicationId
                        && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.acceptedWorkerId == resource.data.workerId
                      )
                    )
                    && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
                    && resource.data.status == 'accepted'
                    && request.resource.data.status == 'completed'
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'updatedAt'])
                    && request.auth.uid in [resource.data.workerId, resource.data.posterId]
                    && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.status == 'completed'
                    && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.workerCompletionConfirmed == true
                    && getAfter(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.posterCompletionConfirmed == true
                    && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null
                    && (
                      (
                        resource.data.workerId == request.auth.uid
                        && resource.data.status == 'rejected'
                      )
                      ||
                      (
                        resource.data.posterId == request.auth.uid
                        && get(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.posterId == request.auth.uid
                        && get(/databases/$(database)/documents/gigs/$(resource.data.gigId)).data.status in ['closed', 'completed']
                      )
                    );
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      allow read: if isParticipant();

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'applicationId',
          'gigId',
          'gigTitle',
          'workerId',
          'posterId',
          'workerName',
          'posterName',
          'workerPhotoUrl',
          'posterPhotoUrl',
          'participants',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'lastReadAt',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'applicationId',
          'gigId',
          'gigTitle',
          'workerId',
          'posterId',
          'workerName',
          'posterName',
          'workerPhotoUrl',
          'posterPhotoUrl',
          'participants',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'lastReadAt',
          'createdAt'
        ])
        && request.auth.uid == request.resource.data.posterId
        && request.resource.data.applicationId == conversationId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([
          request.resource.data.workerId,
          request.resource.data.posterId
        ])
        && getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.workerId == request.resource.data.workerId
        && getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.posterId == request.resource.data.posterId
        && getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.gigId == request.resource.data.gigId
        && (
          !('gigTitle' in getAfter(/databases/$(database)/documents/applications/$(conversationId)).data)
          || getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.gigTitle == request.resource.data.gigTitle
        )
        && (
          !('workerName' in getAfter(/databases/$(database)/documents/applications/$(conversationId)).data)
          || getAfter(/databases/$(database)/documents/applications/$(conversationId)).data.workerName == request.resource.data.workerName
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastReadAt is map
        && request.resource.data.lastReadAt[request.resource.data.posterId] == request.time;

      allow update: if isParticipant()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'hiddenFor'])
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessageAt == request.time
            && (
              !('hiddenFor' in request.resource.data)
              || (
                request.resource.data.hiddenFor is list
                && request.resource.data.hiddenFor.hasOnly(resource.data.get('hiddenFor', []))
                && !request.resource.data.hiddenFor.hasAny([
                  request.auth.uid == resource.data.workerId
                    ? resource.data.posterId
                    : resource.data.workerId
                ])
                && (
                  resource.data.get('hiddenFor', []).hasAny([
                    request.auth.uid == resource.data.workerId
                      ? resource.data.posterId
                      : resource.data.workerId
                  ])
                  ? request.resource.data.hiddenFor.size()
                      == resource.data.get('hiddenFor', []).size() - 1
                  : request.resource.data.hiddenFor.size()
                      == resource.data.get('hiddenFor', []).size()
                )
              )
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hiddenFor'])
            && request.resource.data.hiddenFor is list
            && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor', []))
            && request.resource.data.hiddenFor.size()
                == resource.data.get('hiddenFor', []).size() + 1
            && request.auth.uid in request.resource.data.hiddenFor
            && request.resource.data.hiddenFor.hasOnly(resource.data.participants)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastReadAt'])
            && request.resource.data.lastReadAt is map
            && request.resource.data.lastReadAt.diff(resource.data.lastReadAt)
              .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.lastReadAt[request.auth.uid] == request.time
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        function canAccessConversation() {
          return request.auth != null
            && request.auth.uid in get(
              /databases/$(database)/documents/conversations/$(conversationId)
            ).data.participants
            && !exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.workerId)/blockedUsers/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.posterId))
            && !exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.posterId)/blockedUsers/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.workerId));
        }

        allow read: if canAccessConversation();

        allow create: if canAccessConversation()
          && request.resource.data.keys().hasAll([
            'senderId',
            'text',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'recipientId', 'actorId', 'type', 'title', 'body',
          'relatedId', 'isRead', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'recipientId', 'actorId', 'type', 'title', 'body',
          'relatedId', 'isRead', 'createdAt'
        ])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.type in [
          'application_received', 'application_accepted',
          'application_rejected', 'new_message', 'gig_completion_confirmed',
          'payment_marked', 'payment_received'
        ]
        && (
          (
            request.resource.data.type == 'application_received'
            && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.workerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.posterId == request.resource.data.recipientId
            && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.status == 'pending'
          )
          ||
          (
            request.resource.data.type == 'application_accepted'
            && get(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.posterId == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.workerId == request.resource.data.recipientId
            && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.status == 'accepted'
          )
          ||
          (
            request.resource.data.type == 'application_rejected'
            && get(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.posterId == request.auth.uid
            && get(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.workerId == request.resource.data.recipientId
            && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.relatedId)).data.status == 'rejected'
          )
          ||
          (
            request.resource.data.type == 'new_message'
            && get(/databases/$(database)/documents/conversations/$(request.resource.data.relatedId)).data.participants.hasAll([request.auth.uid, request.resource.data.recipientId])
          )
          ||
          (
            request.resource.data.type == 'gig_completion_confirmed'
            && (
              (
                request.auth.uid == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.posterId
                && request.resource.data.recipientId == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.acceptedWorkerId
                && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.posterCompletionConfirmed == true
              )
              ||
              (
                request.auth.uid == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.acceptedWorkerId
                && request.resource.data.recipientId == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.posterId
                && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.workerCompletionConfirmed == true
              )
            )
          )
          ||
          (
            request.resource.data.type == 'payment_marked'
            && request.auth.uid == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.posterId
            && request.resource.data.recipientId == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.acceptedWorkerId
            && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.posterPaymentConfirmed == true
            && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.status == 'completed'
          )
          ||
          (
            request.resource.data.type == 'payment_received'
            && request.auth.uid == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.acceptedWorkerId
            && request.resource.data.recipientId == get(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.posterId
            && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.posterPaymentConfirmed == true
            && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.workerPaymentConfirmed == true
            && getAfter(/databases/$(database)/documents/gigs/$(request.resource.data.relatedId)).data.paid == true
          )
        )
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.relatedId is string
        && request.resource.data.isRead == false
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;
      allow delete: if request.auth != null
        && resource.data.recipientId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'reporterId', 'targetType', 'targetId', 'reason',
          'details', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetType', 'targetId', 'reason',
          'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['user', 'gig']
        && request.resource.data.targetId is string
        && request.resource.data.reason in [
          'spam', 'fraud', 'harassment', 'unsafe', 'inappropriate', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'gigId', 'reviewerId', 'revieweeId', 'revieweeRole', 'reviewerName',
          'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'gigId', 'reviewerId', 'revieweeId', 'revieweeRole', 'reviewerName',
          'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.revieweeRole in ['worker', 'poster']
        && request.resource.data.revieweeRole == (
          request.auth.uid == get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.posterId
            ? 'worker' : 'poster'
        )
        && reviewId == request.resource.data.gigId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.status == 'completed'
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.workerCompletionConfirmed == true
        && get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.posterCompletionConfirmed == true
        && request.auth.uid in [
          get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.posterId,
          get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.acceptedWorkerId
        ]
        && request.resource.data.revieweeId in [
          get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.posterId,
          get(/databases/$(database)/documents/gigs/$(request.resource.data.gigId)).data.acceptedWorkerId
        ]
        && request.resource.data.revieweeId != request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId}/blockedUsers/{blockedUserId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == blockedUserId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

  }
}
